# Google OAuth — from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Base URL of this app (no trailing slash)
APP_URL=

# MongoDB — mongodb+srv://... for Atlas, or mongodb://localhost:27017/reversim-backoffice for local
MONGODB_URI=

# GitHub asset storage — fine-grained PAT with Contents: read/write,
# scoped to the rs-backoffice repo only. See:
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=rs-backoffice
GITHUB_ASSETS_BRANCH=assets
